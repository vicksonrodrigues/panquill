model User {
  id               String            @id
  firstName        String            @map("first_name")
  lastName         String?           @map("last_name")
  email            String            @unique
  profileImageUrl  String?           @map("profile_image_url")
  isAdmin          Boolean           @default(false) @map("is_admin")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  favouriteRecipes FavouriteRecipe[]
  recipeRatings    RecipeRating[]
  recipeViews      RecipeView[]
  recipes          Recipe[]

  @@map("users")
}

model Recipe {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String
  description       String
  recipeUrl         String?
  imageUrl          String?            @map("image_url")
  prepTime          Int                @default(0) @map("prep_time") @db.SmallInt
  cookTime          Int                @default(0) @map("cook_time") @db.SmallInt
  passiveTime       Int                @default(0) @map("passive_time") @db.SmallInt
  servings          Int                @default(0) @db.SmallInt
  viewCount         Int                @default(0) @map("view_count")
  steps             String[]
  tips              String[]
  isAdminRecipe     Boolean            @default(false) @map("is_admin_recipe")
  isPublished       Boolean            @default(false) @map("is_published")
  publishedDate     DateTime?          @map("published_date") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  authorId          String             @map("author_id")
  courseId          String             @map("course_id") @db.Uuid
  hotScore          Float              @default(0) @map("hot_score")
  favouritesRecipes FavouriteRecipe[]
  recipeCuisines    RecipeCuisine[]
  recipeIngredients RecipeIngredient[]
  recipeRatings     RecipeRating[]
  recipeTags        RecipeTag[]
  recipeTools       RecipeTool[]
  recipeViews       RecipeView[]
  author            User               @relation(fields: [authorId], references: [id])
  course            Course             @relation(fields: [courseId], references: [id])
  editorsChoicePick EditorsChoice?
  searchVector      Unsupported("tsvector")? @map("search_vector")
  @@index([searchVector], type: Gin, map: "recipes_search_vector_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "recipes_title_trgm_idx")

  @@index([isPublished, hotScore])
  @@map("recipes")
}
