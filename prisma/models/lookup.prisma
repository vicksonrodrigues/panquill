model Course {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label     String
  value     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  recipes   Recipe[]

  @@map("courses")
}

model Cuisine {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label          String
  value          String          @unique
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  recipeCuisines RecipeCuisine[]

  @@map("cuisines")
}

model Ingredient {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label             String
  value             String             @unique
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  recipeIngredients RecipeIngredient[]

  @@map("ingredients")
}

model Tag {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label      String
  value      String      @unique
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  recipeTags RecipeTag[]

  @@map("tags")
}

model Tool {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label       String
  value       String       @unique
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  recipeTools RecipeTool[]

  @@map("tools")
}
